<?xml version="1.0"?>
<registry
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    i18n:domain="imio.smartweb">
  <record name="plone.types_not_searched"
            interface="Products.CMFPlone.interfaces.controlpanel.ISearchSchema"
            field="types_not_searched">
      <value purge="false">
        <element>News Item</element>
        <element>Collection</element>
        <element>Discussion Item</element>
        <element>Folder</element>
        <element>File</element>
        <element>Image</element>
        <element>Link</element>
        <element>Document</element>
        <element>Plone Site</element>
        <element>TempFolder</element>
        <element>Event</element>
      </value>
  </record>

  <record name="imio.news.core.search_cache_enabled">
    <field type="plone.registry.field.Bool">
      <title>Enable RAM cache on @search endpoints</title>
      <default>True</default>
    </field>
    <value>True</value>
  </record>

  <record name="imio.news.core.odwb_entites-des-actualites-en-wallonie_pushkey">
    <field type="plone.registry.field.TextLine">
      <title>ODWB : Entit&#233;s des actualit&#233;s en Wallonie - pushkey</title>
    </field>
  </record>

  <record name="imio.news.core.odwb_actualites-en-wallonie_pushkey">
    <field type="plone.registry.field.TextLine">
      <title>ODWB : Actualit&#233;s en Wallonie - pushkey</title>
    </field>
  </record>

  <record name="imio.news.core.odwb_staging-entites-des-actualites-en-wallonie_pushkey">
    <field type="plone.registry.field.TextLine">
      <title>ODWB : Entit&#233;s des actualit&#233;s en Wallonie (STAGING) - pushkey</title>
    </field>
  </record>

  <record name="imio.news.core.odwb_staging-actualites-en-wallonie_pushkey">
    <field type="plone.registry.field.TextLine">
      <title>ODWB : Actualit&#233;s en Wallonie (STAGING) - pushkey</title>
    </field>
  </record>

  <records prefix="plone.bundles/imio-news-core-edit"
           interface='Products.CMFPlone.interfaces.IBundleRegistry'>
    <value key="enabled">True</value>
    <value key="expression">python: member is not None</value>
    <value key="jscompilation">++plone++imio.smartweb.common/directory_contact_autofill.js</value>
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
